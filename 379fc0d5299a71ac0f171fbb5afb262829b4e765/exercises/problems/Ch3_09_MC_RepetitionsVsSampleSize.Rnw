<<echo=FALSE, results=hide>>=
## Script: Section "Approximating Bias, Variance, and MSE using MC Simulations"
##         (law of large numbers: approximations get precise as B -> infinity)
n <- sample(c(10, 20, 30), 1)
B <- sample(c(1000, 5000), 1)
@

\begin{question}
\textbf{Monte Carlo Repetitions vs.\ Sample Size} (Script: Section ``Approximating Bias, Variance, and MSE using MC Simulations'')

You run a Monte Carlo simulation with $B=\Sexpr{B}$ repetitions to approximate the MSE of the sample mean $\bar{X}_n$ for the sample size $n=\Sexpr{n}$. Which of the following statements is correct?
\begin{answerlist}
  \item Increasing $B$ makes the Monte Carlo approximation of $\operatorname{MSE}(\bar{X}_n)$ more precise, but it does not change the true $\operatorname{MSE}(\bar{X}_n)$.
  \item Increasing $B$ makes the true $\operatorname{MSE}(\bar{X}_n)$ smaller.
  \item Increasing $n$ makes the Monte Carlo approximation more precise, but it does not change the true $\operatorname{MSE}(\bar{X}_n)$.
  \item The number of repetitions $B$ must always be equal to the sample size $n$.
\end{answerlist}
\end{question}

\begin{solution}
There are two different ``sample sizes'' in a Monte Carlo simulation:
\begin{itemize}
  \item The \textbf{sample size} $n$ is the number of observations in \emph{one} random sample. It determines the true $\operatorname{MSE}(\bar{X}_n)=\sigma^2/n$, i.e., the quantity that we want to approximate.
  \item The \textbf{number of Monte Carlo repetitions} $B$ is the number of realizations of $\bar{X}_n$ that we generate. By the law of large numbers, the Monte Carlo approximation gets more precise as $B$ gets larger. However, $B$ does not change the true $\operatorname{MSE}(\bar{X}_n)$.
\end{itemize}
\begin{answerlist}
  \item True.
  \item False. The true MSE only depends on the estimator, the data distribution, and the sample size $n$, but not on $B$.
  \item False. The roles of $B$ and $n$ are interchanged: increasing $n$ \emph{changes} (decreases) the true MSE.
  \item False. $B$ and $n$ have different roles and can be chosen independently. Typically, $B$ is much larger than $n$ (e.g., $B=10000$).
\end{answerlist}
\end{solution}

\exname{Monte Carlo Repetitions vs. Sample Size}
\extype{schoice}
\exsolution{1000}
\exshuffle{4}
