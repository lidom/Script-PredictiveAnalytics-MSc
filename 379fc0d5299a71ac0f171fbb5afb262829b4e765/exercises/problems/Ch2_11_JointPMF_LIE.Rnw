<<echo=FALSE, results=hide>>=
## Script: Examples "Two-Dimensional pmf (Car Sales and Staffing)",
##         "Law of Total Expectation (Car Sales and Staffing)", and
##         "Checking Independence in Our Examples"
tabs <- list(rbind(c(0.10, 0.25, 0.10, 0.05), c(0.05, 0.15, 0.20, 0.10)),
             rbind(c(0.15, 0.15, 0.10, 0.00), c(0.05, 0.20, 0.20, 0.15)),
             rbind(c(0.20, 0.20, 0.10, 0.00), c(0.05, 0.15, 0.20, 0.10)))
f   <- tabs[[sample(seq_along(tabs), 1)]]   # rows: x2 = 1, 2; columns: x1 = 0, 1, 2, 3
x1  <- 0:3
f1  <- colSums(f)                           # marginal pmf of X1
f2  <- rowSums(f)                           # marginal pmf of X2
num <- c(sum(x1 * f[1, ]), sum(x1 * f[2, ]))
CM  <- num / f2                             # E(X1 | X2 = 1), E(X1 | X2 = 2)
EX1 <- sum(x1 * f1)
f2  <- round(f2, 2); f1 <- round(f1, 2)
@

\begin{question}
\textbf{Joint pmf, Conditional Means, and Independence} (Script: Examples ``Two-Dimensional pmf (Car Sales and Staffing)'', ``Law of Total Expectation (Car Sales and Staffing)'', and ``Checking Independence in Our Examples'')

Let $X_1\in\{0,1,2,3\}$ be the number of cars sold per day by a car dealership, and let $X_2\in\{1,2\}$ be the number of sales consultants on duty that day. The joint pmf $f(x_1,x_2)=P(X_1=x_1,X_2=x_2)$ is given by the following table:
\begin{center}
\begin{tabular}{c|cccc}
$f(x_1,x_2)$ & $x_1=0$ & $x_1=1$ & $x_1=2$ & $x_1=3$\\\hline
$x_2=1$ & $\Sexpr{fmt(f[1, 1], 2)}$ & $\Sexpr{fmt(f[1, 2], 2)}$ & $\Sexpr{fmt(f[1, 3], 2)}$ & $\Sexpr{fmt(f[1, 4], 2)}$\\
$x_2=2$ & $\Sexpr{fmt(f[2, 1], 2)}$ & $\Sexpr{fmt(f[2, 2], 2)}$ & $\Sexpr{fmt(f[2, 3], 2)}$ & $\Sexpr{fmt(f[2, 4], 2)}$
\end{tabular}
\end{center}
\begin{enumerate}
  \item Compute the marginal pmf $f_1$ of $X_1$ and the marginal pmf $f_2$ of $X_2$.
  \item Compute the conditional means $E(X_1\mid X_2=1)$ and $E(X_1\mid X_2=2)$. Interpret the result.
  \item Compute the unconditional mean $E(X_1)$ in two ways: (i) using the marginal pmf $f_1$, and (ii) using the Law of Total Expectation.
  \item Are $X_1$ and $X_2$ independent? Justify your answer.
\end{enumerate}
\end{question}

\begin{solution}
\begin{enumerate}
  \item The marginal pmfs are obtained by summing the joint pmf over the other variable, i.e., by summing the columns (for $f_1$) and the rows (for $f_2$) of the table:
  \begin{center}
  \begin{tabular}{c|cccc}
  $x_1$      & $0$ & $1$ & $2$ & $3$\\\hline
  $f_1(x_1)$ & $\Sexpr{fmt(f1[1], 2)}$ & $\Sexpr{fmt(f1[2], 2)}$ & $\Sexpr{fmt(f1[3], 2)}$ & $\Sexpr{fmt(f1[4], 2)}$
  \end{tabular}
  \qquad
  \begin{tabular}{c|cc}
  $x_2$      & $1$ & $2$\\\hline
  $f_2(x_2)$ & $\Sexpr{fmt(f2[1], 2)}$ & $\Sexpr{fmt(f2[2], 2)}$
  \end{tabular}
  \end{center}
  For instance, $f_1(0)=f(0,1)+f(0,2)=\Sexpr{fmt(f[1, 1], 2)}+\Sexpr{fmt(f[2, 1], 2)}=\Sexpr{fmt(f1[1], 2)}$.
  \item The conditional means are computed with the conditional pmf $f(x_1\mid x_2)=f(x_1,x_2)/f_2(x_2)$:
  \begin{align*}
  E(X_1\mid X_2=1)
  &=\sum_{x_1} x_1\,\frac{f(x_1,1)}{f_2(1)}\\[1ex]
  &=\frac{0\cdot \Sexpr{fmt(f[1, 1], 2)}+1\cdot \Sexpr{fmt(f[1, 2], 2)}+2\cdot \Sexpr{fmt(f[1, 3], 2)}+3\cdot \Sexpr{fmt(f[1, 4], 2)}}{\Sexpr{fmt(f2[1], 2)}}
   =\frac{\Sexpr{fmt(num[1], 2)}}{\Sexpr{fmt(f2[1], 2)}}=\Sexpr{fmt(CM[1], 3)},\\[2ex]
  E(X_1\mid X_2=2)
  &=\sum_{x_1} x_1\,\frac{f(x_1,2)}{f_2(2)}\\[1ex]
  &=\frac{0\cdot \Sexpr{fmt(f[2, 1], 2)}+1\cdot \Sexpr{fmt(f[2, 2], 2)}+2\cdot \Sexpr{fmt(f[2, 3], 2)}+3\cdot \Sexpr{fmt(f[2, 4], 2)}}{\Sexpr{fmt(f2[2], 2)}}
   =\frac{\Sexpr{fmt(num[2], 2)}}{\Sexpr{fmt(f2[2], 2)}}=\Sexpr{fmt(CM[2], 3)}.
  \end{align*}
  On days with one consultant, the dealership sells $\Sexpr{fmt(CM[1], 3)}$ cars on average; on days with two consultants, it sells $\Sexpr{fmt(CM[2], 3)}$ cars on average.
  \item (i) Using the marginal pmf $f_1$:
  $$
  E(X_1)=0\cdot \Sexpr{fmt(f1[1], 2)}+1\cdot \Sexpr{fmt(f1[2], 2)}+2\cdot \Sexpr{fmt(f1[3], 2)}+3\cdot \Sexpr{fmt(f1[4], 2)}=\Sexpr{fmt(EX1, 2)}.
  $$
  (ii) Using the Law of Total Expectation, we average the conditional means, weighted by the probabilities of $X_2$:
  \begin{align*}
  E(X_1)
  &=E\big(E(X_1\mid X_2)\big)\\[1ex]
  &=E(X_1\mid X_2=1)\,f_2(1)+E(X_1\mid X_2=2)\,f_2(2)\\[1ex]
  &=\Sexpr{fmt(CM[1], 3)}\cdot \Sexpr{fmt(f2[1], 2)}+\Sexpr{fmt(CM[2], 3)}\cdot \Sexpr{fmt(f2[2], 2)}\\[1ex]
  &=\Sexpr{fmt(EX1, 2)}.
  \end{align*}
  \item No. Independence requires $f(x_1,x_2)=f_1(x_1)\,f_2(x_2)$ for \emph{all} pairs $(x_1,x_2)$. This fails, for instance, for $(x_1,x_2)=(0,1)$:
  $$
  f(0,1)=\Sexpr{fmt(f[1, 1], 2)}\neq \Sexpr{fmt(f1[1] * f2[1], 3)}=\Sexpr{fmt(f1[1], 2)}\cdot\Sexpr{fmt(f2[1], 2)}=f_1(0)\,f_2(1).
  $$
  This is also visible in (b): the conditional mean of $X_1$ depends on $X_2$, which is impossible if $X_1$ and $X_2$ are independent.
\end{enumerate}
\end{solution}

\exname{Joint pmf, Conditional Means, and Independence}
\extype{string}
\exsolution{nil}
